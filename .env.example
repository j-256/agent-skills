# Local configuration for the eval harnesses (trigger-eval.py, synthesis-eval.py).
# Copy this file to `.env` and edit. `.env` is gitignored.
#
# Variables are loaded into os.environ at harness startup. Existing
# environment values win – `.env` only fills gaps.

# DSC_EVAL_MODEL: identifier passed to `claude --model`. Use whatever
# value your gateway accepts. Common choices:
#   sonnet              – the Claude Code alias (resolves to the older Sonnet)
#   claude-sonnet-4-6   – the public Anthropic ID
#   <gateway-specific>  – if your environment requires a profile-prefixed ID
#
# Pin the exact identifier your gateway accepts here rather than relying
# on the `sonnet` alias – `sonnet` resolves to the older Sonnet (`opus`
# likewise resolves to the older Opus), so explicit pinning is necessary
# if you want to run on the newer version.
#
# Build on Opus, eval on Sonnet (see CLAUDE.md "Model targeting for evals").
DSC_EVAL_MODEL=sonnet
