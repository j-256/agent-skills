# Local configuration for Claude-backed stream-eval and the opt-in live tests
# Copy this file to `.env` and edit; `.env` is gitignored
#
# Variables are loaded two ways, both gap-fill only so an existing environment value wins
#   - stream-eval loads `.env` at startup
#   - Node live tests load it through plugins/dsc/shared/common/live-test.js
# The same `.env` serves both; it is unnecessary when the shell already exports the values

# STREAM_EVAL_MODEL: identifier passed to `claude --model`
# Use an alias, a public Anthropic model ID, or the profile-prefixed ID your gateway accepts
#
# Pin an exact identifier when alias drift would make measurements incomparable
#
# Build with the strongest available reasoning model and evaluate on the representative Sonnet target
# See AGENTS.md "Eval harness"
STREAM_EVAL_MODEL=sonnet

# --- Live-test sandbox credentials (opt-in: DSC_LIVE_TESTS=1) ---
# The opt-in live tests (test-auth-render-live, test-body-render-live,
# test-examples-runnable) execute rendered runnables against a B2C Commerce
# sandbox. Values live only in .env (gitignored); never commit them
# DSC_LIVE_INSTANCE is your sandbox instance/tenant id (e.g. abcd_001); the org id
# (f_ecom_<instance>) and the sandbox's OCAPI host derive from it
DSC_LIVE_INSTANCE=
# Each live test/probe self-skips when its own creds are absent, so set only what
# you want to exercise. By test:
#   test-examples-runnable (the trophies):
#     guest flows   -- SCAPI_SHORTCODE, SLAS_PUBLIC_CLIENT_ID, CLIENT_ID_OCAPI
#     registered    -- + SHOPPER_USER, SHOPPER_PASS (below)
#   test-body-render-live -- SCAPI_SHORTCODE, SLAS_PRIVATE_CLIENT_ID, SLAS_PRIVATE_CLIENT_SECRET, CLIENT_ID_OCAPI
#   test-auth-render-live -- AM probe: CLIENT_ID_SCAPI, CLIENT_SECRET_SCAPI;
#                            OCAPI probe: CLIENT_ID_OCAPI;
#                            SLAS-guest probe: SLAS_PUBLIC_CLIENT_ID, SLAS_REDIRECT_URI
# The registered-flow trophies (add-coupon, inreference) also need a pre-provisioned
# test shopper: a Customer Profile on the site (a shopper LOGIN + password), created via
# registerCustomer. Provision once, then set:
SHOPPER_USER=
SHOPPER_PASS=
