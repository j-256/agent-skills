# Local configuration for the eval harnesses (trigger-eval.py, synthesis-eval.py)
# and the opt-in live tests. Copy this file to `.env` and edit. `.env` is gitignored.
#
# Variables are loaded into the environment two ways, both gap-fill only (an existing
# environment value always wins – `.env` never overrides it):
#   - the Python harnesses load `.env` at startup;
#   - the node live tests load it via skills/_shared/live-order.js.
# So the same `.env` serves both. If your shell already exports these (e.g. from a
# private startup script), `.env` is unnecessary – it exists so a fresh clone with no
# such script can still supply live-test credentials.

# DSC_EVAL_MODEL: identifier passed to `claude --model`. Use whatever
# value your gateway accepts. Common choices:
#   sonnet              – the Claude Code alias (resolves to the older Sonnet)
#   claude-sonnet-4-6   – the public Anthropic ID
#   <gateway-specific>  – if your environment requires a profile-prefixed ID
#
# Pin the exact identifier your gateway accepts here rather than relying
# on the `sonnet` alias – `sonnet` resolves to the older Sonnet (`opus`
# likewise resolves to the older Opus), so explicit pinning is necessary
# if you want to run on the newer version.
#
# Build on Opus, eval on Sonnet (see CLAUDE.md "Model targeting for evals").
DSC_EVAL_MODEL=sonnet

# --- Live-test sandbox credentials (opt-in: DSC_LIVE_TESTS=1) ---
# The opt-in live tests (test-auth-render-live, test-body-render-live,
# test-examples-runnable) execute rendered runnables against a B2C Commerce
# sandbox. Values live only in .env (gitignored); never commit them.
# DSC_LIVE_INSTANCE is your sandbox instance/tenant id (e.g. abcd_001); the org id
# (f_ecom_<instance>) and the sandbox's OCAPI host derive from it.
DSC_LIVE_INSTANCE=
# Each live test/probe self-skips when its own creds are absent, so set only what
# you want to exercise. By test:
#   test-examples-runnable (the trophies):
#     guest flows   -- SCAPI_SHORTCODE, SLAS_PUBLIC_CLIENT_ID, CLIENT_ID_OCAPI
#     registered    -- + SHOPPER_USER, SHOPPER_PASS (below)
#   test-body-render-live -- SCAPI_SHORTCODE, SLAS_PRIVATE_CLIENT_ID, SLAS_PRIVATE_CLIENT_SECRET, CLIENT_ID_OCAPI
#   test-auth-render-live -- AM probe: CLIENT_ID_SCAPI, CLIENT_SECRET_SCAPI;
#                            OCAPI probe: CLIENT_ID_OCAPI;
#                            SLAS-guest probe: SLAS_PUBLIC_CLIENT_ID, SLAS_REDIRECT_URI
# The registered-flow trophies (add-coupon, inreference) also need a pre-provisioned
# test shopper: a Customer Profile on the site (a shopper LOGIN + password), created via
# registerCustomer. Provision once, then set:
SHOPPER_USER=
SHOPPER_PASS=
