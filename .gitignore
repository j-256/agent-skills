node_modules/
.DS_Store
*.log
__pycache__/
*.pyc

# Eval state lives under evals/<skill>/. Track the authored eval sets
# (trigger-eval.json) and per-iteration prose notes (iteration-*.md) in
# history so commits that cite eval numbers reference a reproducible
# input set. The heavy run artifacts go under runs/ and stay local.
evals/*/runs/

# Stray output paths from trigger-eval runs where Sonnet passed CLI flag
# names as positional output dirs (--cache, --list-only, etc.) or
# left an unexpanded `~/...` literal as a scrape output dir
skills/dsc-scrape/--*/
/--*/
/~/

# Brainstorming specs + implementation plans — kept locally for reference
# during implementation, not tracked in history
docs/superpowers/specs/
docs/superpowers/plans/

# Local config for harnesses (see .env.example).
.env

# Playwright MCP scratch dir (browser console logs + page snapshots);
# ephemeral.
.playwright-mcp/

# venv created by `pip install -e ./harness` for the eval harness.
.venv/
